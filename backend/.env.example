SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
USE_SQLITE=True
DATABASE_NAME=qaip_db
DATABASE_USER=postgres
DATABASE_PASSWORD=your-password
DATABASE_HOST=localhost
DATABASE_PORT=5432
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ORIGIN=http://localhost:3000
MEDIA_ROOT=media/
JWT_SECRET=your-jwt-secret-for-fastapi-shared-verification

# ── Email ──────────────────────────────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="QAIP Platform <your_email@gmail.com>"

# ── Judge0 Code Execution Engine ───────────────────────────────────────────
# Local Judge0 CE: docker run -p 2358:2358 judge0/judge0-ce:latest
# RapidAPI hosted: https://judge0-ce.p.rapidapi.com
JUDGE0_API_URL=http://localhost:2358
JUDGE0_API_KEY=

# Judge0 language IDs (defaults match Judge0 CE standard image)
# Python 3: 71 | Java: 62 | C++ (GCC 9.2): 54
# Override only if your Judge0 installation uses different IDs
JUDGE0_LANG_PYTHON=71
JUDGE0_LANG_JAVA=62
JUDGE0_LANG_CPP=54
